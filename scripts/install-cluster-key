#!/usr/bin/env python3
"""Install the shared cluster SSH key read from stdin, without putting it in arguments.

Usage: age --decrypt -i <fleet identity> cluster-ssh-key.age | scripts/install-cluster-key [--replace SHA256:...]
Writes the configured cluster key (0600) and its derived public key (0644) through the
guarded writer. An existing different key is kept and reported as a local override,
unless its fingerprint equals the --replace value given for an authorized rotation.
Prints one JSON line: installed, unchanged, or override with the existing fingerprint.
"""
import argparse
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
sys.dont_write_bytecode = True  # keep the dotfiles checkout clean
from deployment_config import load_config, checked_ssh_dir
spec = importlib.util.spec_from_file_location('writer', Path(__file__).with_name('replace-managed-file.py'))
writer = importlib.util.module_from_spec(spec)
spec.loader.exec_module(writer)


def fingerprint(path):
    result = subprocess.run(['ssh-keygen', '-l', '-f', str(path)], capture_output=True, text=True, check=True)
    return result.stdout.split()[1]


def inspect_private(private_bytes, *, derive=False):
    state = Path.home() / '.local/state/agent-update'
    state.mkdir(mode=0o700, parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=state) as work:
        key = Path(work) / 'key'
        fd = os.open(key, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'wb') as stream:
            stream.write(private_bytes)
        if derive:
            return subprocess.check_output(['ssh-keygen', '-y', '-P', '', '-f', str(key)],
                                           stderr=subprocess.PIPE)
        # No neighbouring .pub can supply the fingerprint of a different file.
        return fingerprint(key)


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--deployment-config')
    parser.add_argument('--replace')
    args = parser.parse_args()
    config = load_config(args.deployment_config)
    replace_fingerprint = args.replace
    private = sys.stdin.buffer.read()
    if b'PRIVATE KEY' not in private:
        print(json.dumps({'status': 'failed', 'error_type': 'not a private key'}))
        return 1
    checked_ssh_dir()
    key = Path(config['paths']['cluster_key']).expanduser()
    pub = key.with_name(key.name + '.pub')
    current = writer.snapshot(key)[0] if key.exists() or key.is_symlink() else None
    current_pub = writer.snapshot(pub)[0] if pub.exists() or pub.is_symlink() else None
    public = inspect_private(private, derive=True)
    wanted = inspect_private(private)
    previous = inspect_private(current) if current is not None else None
    if previous is not None and previous != wanted and previous != replace_fingerprint:
        print(json.dumps({'status': 'override', 'existing_fingerprint': previous}))
        return 0
    if current_pub is not None and current_pub.split()[:2] != public.split()[:2]:
        # Only an explicitly authorized rotation owns an old matching public half.
        if not (previous and previous == replace_fingerprint and fingerprint(pub) == previous):
            print(json.dumps({'status': 'conflict', 'error_type': 'different existing public key'}))
            return 1
    if previous == wanted:
        private = current
    if current_pub is not None and current_pub.split()[:2] == public.split()[:2]:
        public = current_pub
    results = [writer.replace(key, current, private, 0o600, allow_create=True),
               writer.replace(pub, current_pub, public, 0o644,
                              allow_create=True)]
    status = 'unchanged' if results == ['unchanged', 'unchanged'] else 'installed'
    print(json.dumps({'status': status, 'fingerprint': fingerprint(key)}))
    return 0


if __name__ == '__main__':
    sys.exit(main())
