#!/usr/bin/env python3
"""Receive an approved, decrypted token on stdin using the installed HF runtime."""
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys

os.umask(0o077)
if sys.stdin.isatty():
    sys.exit('Pipe the approved private HF payload here; see SECRETS.md.')
os.environ['PATH'] = str(Path.home() / '.local/bin') + os.pathsep + os.environ['PATH']
helper = Path(__file__).resolve().with_name('install-hf-from-stdin.py')
try:
    hf = shutil.which('hf')
    if not hf:
        raise RuntimeError('HF CLI unavailable')
    hf = str(Path(hf).resolve())
    runtime = runpy.run_path(str(helper))['hf_python'](hf)
    subprocess.run([runtime, '-c', 'import huggingface_hub'], check=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
except Exception:
    sys.exit('Cannot locate the installed Hugging Face CLI Python runtime.')
os.execv(runtime, [runtime, str(helper), hf])
