#!/usr/bin/env bash

set -euo pipefail
set +x
umask 077

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

if [[ -d "$HOME/.local/bin" ]]; then
    PATH="$HOME/.local/bin:$PATH"
    export PATH
fi

if ! hf_cli=$(command -v hf); then
    echo "Error: the Hugging Face CLI is required." >&2
    exit 1
fi

hf_cli=$(realpath "$hf_cli")
python_bin="$(dirname "$hf_cli")/python"
if [[ ! -x "$python_bin" ]] || ! "$python_bin" -c 'import huggingface_hub' >/dev/null 2>&1; then
    echo "Error: cannot find the Python environment used by the Hugging Face CLI." >&2
    exit 1
fi

"$SCRIPT_DIR/with-hf-token" "$python_bin" -c '
import os
from pathlib import Path

from huggingface_hub import constants, login

login(
    token=os.environ["HF_TOKEN"],
    add_to_git_credential=False,
    skip_if_logged_in=False,
)
for token_path in (constants.HF_TOKEN_PATH, constants.HF_STORED_TOKENS_PATH):
    path = Path(token_path)
    if path.exists():
        path.chmod(0o600)
'

env -u HF_TOKEN -u HUGGING_FACE_HUB_TOKEN "$hf_cli" auth whoami >/dev/null
echo "Hugging Face credential installed and verified."
