# Interactive bash settings for development servers.
# ~/.bashrc sources this file through one guarded line managed by agent-update.
[[ $- == *i* ]] || return

export TT_METAL_HOME="$HOME/tt-metal"
export TT_METAL_RUNTIME_ROOT="$TT_METAL_HOME"
case ":${PYTHONPATH:-}:" in *":$TT_METAL_HOME:"*) ;; *) export PYTHONPATH="$TT_METAL_HOME:$TT_METAL_HOME/ttnn:$TT_METAL_HOME/tools${PYTHONPATH:+:$PYTHONPATH}" ;; esac
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac
alias tt_venv='source "$HOME/tt-metal/python_env/bin/activate"'

# Host labels come from the private inventory; agent-update writes this file.
__dotfiles_host_label() {
    local node="${HOSTNAME%%.*}" labels="$HOME/.config/agent-update/host-labels" name label
    if [[ -r $labels ]]; then
        while read -r name label; do
            [[ $name == "$node" ]] && { printf '%s' "$label"; return; }
        done < "$labels"
    fi
    printf '%s' "$node"
}

__dotfiles_server_banner() {
    local node="${HOSTNAME%%.*}" label
    label=$(__dotfiles_host_label)
    if [[ -t 1 && ${TERM:-dumb} != dumb ]]; then
        printf '\033[1;36m============================================================\033[0m\n'
        printf '\033[1;33m  %s\033[0m\n' "$label"
        printf '  %s@%s | TT-Metal: %s\n' "$USER" "$node" "$TT_METAL_HOME"
        printf '\033[1;36m============================================================\033[0m\n'
    else
        printf '=== %s | %s@%s ===\n' "$label" "$USER" "$node"
    fi
}

# Inside tmux, refresh SSH_AUTH_SOCK so agent forwarding survives reattachment.
__dotfiles_update_ssh_auth_sock() {
    if [[ -n ${TMUX:-} ]]; then
        local sock
        sock=$(tmux show-environment SSH_AUTH_SOCK 2>/dev/null) || return 0
        sock=${sock#SSH_AUTH_SOCK=}
        [[ ! -S "$sock" ]] || export SSH_AUTH_SOCK="$sock"
    fi
    return 0
}
if [[ $(declare -p PROMPT_COMMAND 2>/dev/null) == "declare -a"* ]]; then
    if [[ ";${PROMPT_COMMAND[*]};" != *"__dotfiles_update_ssh_auth_sock"* ]]; then
        PROMPT_COMMAND+=(__dotfiles_update_ssh_auth_sock)
    fi
else
    case ";${PROMPT_COMMAND:-};" in
        *";__dotfiles_update_ssh_auth_sock;"*) ;;
        *) PROMPT_COMMAND="__dotfiles_update_ssh_auth_sock${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
    esac
fi

unalias clear 2>/dev/null || true
clear() {
    command clear "$@" || return
    __dotfiles_update_ssh_auth_sock
    __dotfiles_server_banner
}
if [[ -t 0 && ${TERM:-dumb} != dumb ]]; then
    bind -x '"\C-l":clear'
fi
__dotfiles_server_banner
