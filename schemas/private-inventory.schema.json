{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "approval",
    "nodes",
    "profiles",
    "targets",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "approval": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "approved"
          ]
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "ip",
          "aliases"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
          },
          "ip": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
            }
          },
          "deprecated_aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
            }
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "files",
          "ssh_equivalence",
          "device_role",
          "expected_hostname",
          "account"
        ],
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "before",
                "after",
                "mode"
              ],
              "properties": {
                "path": {
                  "enum": [
                    "/etc/hosts",
                    "~/.ssh/config",
                    "~/.ssh/moreh_cluster.conf",
                    "/etc/cloud/cloud.cfg.d/99-moreh-preserve-hosts.cfg"
                  ]
                },
                "before": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "after": {
                  "type": "string"
                },
                "mode": {
                  "enum": [
                    "0600",
                    "0644"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "ssh_equivalence": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "device_role": {
            "type": "string",
            "enum": [
              "development-server",
              "personal-device"
            ]
          },
          "preserved_hosts_blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hosts_scope": {
            "type": "object",
            "required": [
              "managed_node_names",
              "deprecated_alias_policy"
            ],
            "properties": {
              "managed_node_names": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "deprecated_alias_policy": {
                "enum": [
                  "separate-block",
                  "omit"
                ]
              },
              "blocks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "title",
                    "node_names"
                  ],
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^\\r\\n]+$"
                    },
                    "node_names": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "expected_hostname": {
            "type": "string",
            "minLength": 1
          },
          "account": {
            "type": "string",
            "minLength": 1
          },
          "authorized_alias_removals": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "configuration_owner": {
            "type": "string",
            "minLength": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "hosts_scope"
            ],
            "not": {
              "required": [
                "configuration_owner"
              ]
            }
          },
          {
            "required": [
              "configuration_owner"
            ],
            "properties": {
              "files": {
                "maxItems": 0
              },
              "ssh_equivalence": {
                "maxItems": 0
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "hosts_scope"
                  ]
                },
                {
                  "required": [
                    "preserved_hosts_blocks"
                  ]
                },
                {
                  "required": [
                    "authorized_alias_removals"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sources": {
      "type": [
        "object",
        "array"
      ]
    }
  }
}
